+/* ATRAC3plus stereo: one AU is an 8-byte ATS header (0x0F 0xD0, rate and
+ * channels, frame size / 8 - 1) and one frame. Writes 2048 interleaved
+ * big-endian float samples a channel to dst; 0 when the AU did not decode. */
+static u32 adec_at3_decode(AdecSlot* a, const u8* au, u32 size, u32 dst)
+{
+    float l[ADEC_ATRACX_SAMPLES], r[ADEC_ATRACX_SAMPLES];
+    u32 pcm[ADEC_ATRACX_SAMPLES * 2];
+    u32 frame = size;
+    int n = 0;
+
+    if (size > 8 && au[0] == 0x0F && au[1] == 0xD0) {
+        frame = ((((u32)au[2] & 3u) << 8) | au[3]) * 8u + 8u;
+        au += 8;
+        if (frame > size - 8u) return 0;
+    }
+    if (!a->at3) {
+        int align = (int)frame;
+        a->at3 = at3p_open(2, &align);
+        if (!a->at3) return 0;
+    }
+    if (at3p_decode(a->at3, l, r, &n, au, (int)frame) < 0 || n != (int)ADEC_ATRACX_SAMPLES) {
+        static int _n = 0;
+        if (PS3_LOG_FIRST(_n, 4))
+            printf("[cellAdec] ATRAC3plus frame of %u bytes did not decode\n", frame);
+        return 0;
+    }
+    float peak = 0.0f;
+    for (u32 i = 0; i < ADEC_ATRACX_SAMPLES * 2u; i++) {
+        float v = (i & 1u) ? r[i / 2] : l[i / 2];
+        u32 w;
+        memcpy(&w, &v, 4);
+        pcm[i] = (w >> 24) | ((w >> 8) & 0xFF00u) | ((w << 8) & 0xFF0000u) | (w << 24);
+        if (v > peak) peak = v;
+    }
+    if (peak > 0.01f) {
+        static int _n = 0;
+        if (PS3_LOG_FIRST(_n, 1))
+            printf("[cellAdec] ATRAC3plus audible: frame=%u bytes, peak=%.3f\n", frame, peak);
+    }
+    vm_memcpy_to(dst, pcm, sizeof(pcm));
+    return (u32)sizeof(pcm);
+}
+
+static void adec_at3_close(AdecSlot* a)
+{
+    if (a->at3) at3p_close(a->at3);
+    a->at3 = NULL;
+}
