+/* The view a texture unit needs, or -1 when the texture is not a part of a
+ * linear render target used this frame. */
+static int rt_view_for(u32 raw, u32 w, u32 h, u32 fmt, u32 pitch)
+{
+    if (!raw || !w || !h || !(fmt & 0x20) || (fmt & 0x9F) != 0x85 || pitch <= 64) return -1;
+    int p = -1; u32 px = 0, py = 0;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (!r->res || !r->used || r->pitch != pitch || r->off > raw ||
+            r->dxgi != (u32)DXGI_FORMAT_R8G8B8A8_UNORM) continue;
+        const u32 d = raw - r->off, y = d / pitch, x = (d % pitch) / 4u;
+        if (x + w > r->w || y + h > r->h) continue;
+        if (p >= 0 && r->off < s_d3d.off_rt[p].off) continue;
+        p = i; px = x; py = y;
+    }
+    if (p < 0) return -1;
+    if (s_d3d.off_rt[p].off == raw &&
+        s_d3d.off_rt[p].w == w && s_d3d.off_rt[p].h == h) return -1;
+    int slot = -1;
+    for (int i = 0; i < MAX_RT_VIEWS; i++) {
+        RtView* v = &s_rt_view[i];
+        if (v->res && v->parent == p && v->x == px && v->y == py && v->w == w && v->h == h) {
+            v->last_frame = s_d3d.frame_count; return i; }
+        if (slot < 0 && !v->res) slot = i;
+    }
+    if (slot < 0)
+        for (int i = 0; i < MAX_RT_VIEWS; i++)
+            if (s_rt_view[i].last_frame != s_d3d.frame_count) {
+                wait_for_gpu(); d3d_retire(s_rt_view[i].res); s_rt_view[i].res = NULL;
+                slot = i; break; }
+    if (slot < 0) return -1;
+    RtView* v = &s_rt_view[slot];
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = w; td.Height = h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count = 1;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+            &IID_ID3D12Resource, (void**)&v->res)))
+        return -1;
+    v->st = D3D12_RESOURCE_STATE_COPY_DEST;
+    v->parent = p; v->x = px; v->y = py; v->w = w; v->h = h;
+    v->wgen = s_d3d.off_rt[p].wgen - 1u;
+    v->last_frame = s_d3d.frame_count;
+    return slot;
+}
+
+static void rt_view_barrier(RtView* v, D3D12_RESOURCE_STATES to)
+{
+    if (v->st == to) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = v->res;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = v->st; b.Transition.StateAfter = to;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    v->st = to;
+}
+
+/* Copy the surface region into the view if the surface changed. Returns 1 when
+ * a copy was recorded (the caller must rebind its render targets). */
+static int rt_view_refresh(int i)
+{
+    RtView* v = &s_rt_view[i];
+    if (!v->res || v->wgen == s_d3d.off_rt[v->parent].wgen) return 0;
+    off_rt_transition(v->parent, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    rt_view_barrier(v, D3D12_RESOURCE_STATE_COPY_DEST);
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = v->res; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = s_d3d.off_rt[v->parent].res;
+    src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX box = { v->x, v->y, 0, v->x + v->w, v->y + v->h, 1 };
+    s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &dst, 0, 0, 0, &src, &box);
+    rt_view_barrier(v, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    v->wgen = s_d3d.off_rt[v->parent].wgen;
+    return 1;
+}
