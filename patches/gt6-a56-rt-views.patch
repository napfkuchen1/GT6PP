+/* A texture that reads part of a linear render target (a sub-address, or a
+ * smaller declared size at its start) gets its own resource of the declared
+ * size, refreshed by a region copy whenever the surface was written since. */
+#define MAX_RT_VIEWS 48
+typedef struct {
+    ID3D12Resource* res;
+    D3D12_RESOURCE_STATES st;
+    int parent;
+    u32 x, y, w, h, wgen;
+    u64 last_frame;
+} RtView;
+static RtView s_rt_view[MAX_RT_VIEWS];
+
+static void rt_view_drop(int parent)
+{
+    for (int i = 0; i < MAX_RT_VIEWS; i++)
+        if (s_rt_view[i].res && s_rt_view[i].parent == parent) {
+            wait_for_gpu();
+            d3d_retire(s_rt_view[i].res); s_rt_view[i].res = NULL;
+        }
+}
