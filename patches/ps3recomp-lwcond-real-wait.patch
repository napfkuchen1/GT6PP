+/* Real lwcond: lv2 never wakes a waiter spuriously. A waiter parks on a
+ * per-lwcond semaphore after releasing the paired lwmutex; signal / signal_all
+ * give out one / all tickets for threads waiting right now (a signal with
+ * nobody waiting is lost, as on lv2). PS3_LWCOND_POLL=1 restores the old
+ * 1 ms poll with no-op signals. signal_to (r4 = thread id) wakes any one
+ * waiter, who is waiting is not tracked. */
+struct LwcSlot { uint32_t addr; HANDLE sem; long waiters; };
+static LwcSlot g_lwc[256];
+static CRITICAL_SECTION g_lwc_cs;
+static INIT_ONCE g_lwc_once = INIT_ONCE_STATIC_INIT;
+static BOOL CALLBACK lwc_init_cb(PINIT_ONCE, PVOID, PVOID*) { InitializeCriticalSection(&g_lwc_cs); return TRUE; }
+static LwcSlot* lwc_slot(uint32_t addr)   /* g_lwc_cs held */
+{
+    for (int i = 0; i < 256; i++) if (g_lwc[i].addr == addr) return &g_lwc[i];
+    for (int i = 0; i < 256; i++) if (!g_lwc[i].addr) {
+        g_lwc[i].addr = addr; g_lwc[i].waiters = 0;
+        g_lwc[i].sem = CreateSemaphoreA(NULL, 0, 0x7FFFFFFF, NULL);
+        return &g_lwc[i];
+    }
+    return nullptr;
+}
+static int lwc_poll_mode(void)
+{
+    static int m = -1;
+    if (m < 0) { const char* e = getenv("PS3_LWCOND_POLL"); m = (e && *e == '1') ? 1 : 0; }
+    return m;
+}
+static void lwc_signal(ppu_context* ctx, int all)
+{
+    uint32_t addr = (uint32_t)ctx->gpr[3];
+    ctx->gpr[3] = 0;
+    if (lwc_poll_mode()) return;
+    InitOnceExecuteOnce(&g_lwc_once, lwc_init_cb, NULL, NULL);
+    EnterCriticalSection(&g_lwc_cs);
+    LwcSlot* c = lwc_slot(vm_read32(addr + 0x04));
+    if (getenv("PS3_LWCOND_LOG")) fprintf(stderr, "[LWC] signal%s lwc=0x%08X tid=%llu waiters=%ld lr=0x%08X\n", all ? "_all" : "", addr, (unsigned long long)ctx->thread_id, c ? c->waiters : -1L, (unsigned)ctx->lr);
+    if (c && c->waiters > 0) {
+        long n = all ? c->waiters : 1;
+        c->waiters -= n;
+        ReleaseSemaphore(c->sem, n, NULL);
+    }
+    LeaveCriticalSection(&g_lwc_cs);
+}
 static void sys_lwcond_destroy(ppu_context* ctx)    { ctx->gpr[3] = 0; }
