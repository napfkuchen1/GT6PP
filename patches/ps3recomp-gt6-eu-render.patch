         char* rp = strstr(hlsl, "_po.c0 = ");
+        char* tailp = rp ? NULL : strstr(hlsl, "return (_o == _o) ? _o : (float4)0;");
+        if (tailp) {
+            /* Current decompiler output ends in a NaN-guarded return and has no
