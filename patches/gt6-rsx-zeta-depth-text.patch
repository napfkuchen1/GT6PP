+/* 1 when any draw of this frame samples the depth surface at `off` as a texture
+ * (GT6 text: glyphs write stencil, a later cover pass reads it back). */
+static int zeta_sampled(u32 off, u32* pw, u32* ph)
+{
+    for (u32 d = 0; d < s_d3d.draw_count && d < MAX_DRAWS; d++) {
+        const D3D12DrawRecord* r = &s_d3d.draws[d];
+        if (!r->is_vp || r->is_clear) continue;
+        for (int u = 0; u < 16; u++)
+            if (r->tex[u].set && r->tex[u].raw == off) { *pw = r->tex[u].w; *ph = r->tex[u].h; return 1; }
+    }
+    return 0;
+}
