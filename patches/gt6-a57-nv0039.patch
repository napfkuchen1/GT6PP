+/* NV0039 (memory to memory): the buffer copy behind cellGcmSetTransferData,
+ * bound to subchannel 1. NV0039_DBG=<n> logs the first n copies. */
+static struct { u32 dma_in, dma_out, off_in, off_out, pitch_in, pitch_out, len, count, fmt; } s_nv0039;
+
+static int nv0039_is(u32 method)
+{
+    return method == 0x0184u || method == 0x0188u || (method >= 0x030Cu && method <= 0x0328u);
+}
+
+static void nv0039_copy(void)
+{
+    extern u8* vm_base;
+    const int sl = s_nv0039.dma_in != 0xFEED0001u, dl = s_nv0039.dma_out != 0xFEED0001u;
+    const u32 len = s_nv0039.len, n = s_nv0039.count;
+    const u32 inc_in = s_nv0039.fmt & 0xFF, inc_out = (s_nv0039.fmt >> 8) & 0xFF;
+    const u64 limit = ppu_vm_size ? ppu_vm_size : VM_TOTAL_SIZE;
+    static int cap = -1, logged = 0;
+    if (cap < 0) { const char* e = getenv("NV0039_DBG"); cap = e ? atoi(e) : 8; }
+    if (logged < cap) { logged++;
+        printf("[NV0039] %ux%u fmt=0x%X src=%s 0x%08X/%u dst=%s 0x%08X/%u\n", len, n, s_nv0039.fmt,
+               sl ? "LOCAL" : "MAIN", s_nv0039.off_in, s_nv0039.pitch_in,
+               dl ? "LOCAL" : "MAIN", s_nv0039.off_out, s_nv0039.pitch_out); }
+    if (!len || !n || inc_in != 1 || inc_out != 1) return;
+    if (sl && s_rt_readback && s_nv0039.pitch_in && !(len & 3)) {
+        const u32 ea = cellGcmResolveLocated(1, s_nv0039.off_in);
+        if (ea && (u64)ea + (u64)(n - 1u) * s_nv0039.pitch_in + len <= limit)
+            s_rt_readback(s_nv0039.off_in, s_nv0039.pitch_in, len / 4u, n, vm_base + ea);
+    }
+    for (u32 y = 0; y < n; y++) {
+        const u32 s = cellGcmResolveLocated(sl, s_nv0039.off_in + y * s_nv0039.pitch_in);
+        const u32 d = cellGcmResolveLocated(dl, s_nv0039.off_out + y * s_nv0039.pitch_out);
+        if (!s || !d || (u64)s + len > limit || (u64)d + len > limit) break;
+        gcm_store(d, vm_base + s, len);
+    }
+}
+
+static void nv0039_method(u32 method, u32 data)
+{
+    switch (method) {
+    case 0x0184: s_nv0039.dma_in    = data; break;
+    case 0x0188: s_nv0039.dma_out   = data; break;
+    case 0x030C: s_nv0039.off_in    = data; break;
+    case 0x0310: s_nv0039.off_out   = data; break;
+    case 0x0314: s_nv0039.pitch_in  = data; break;
+    case 0x0318: s_nv0039.pitch_out = data; break;
+    case 0x031C: s_nv0039.len       = data; break;
+    case 0x0320: s_nv0039.count     = data; break;
+    case 0x0324: s_nv0039.fmt       = data; break;
+    case 0x0328: nv0039_copy(); break;
+    }
+}
