+/* AUDIO_TS_TRACE=1: first calls, then every 200th, with the port's read index. */
+static void audio_ts_trace(const char* what, u32 portNum, u64 in, u64 out)
+{
+    static int on = -1;
+    static unsigned n[2];
+    if (on < 0) on = getenv("AUDIO_TS_TRACE") ? 1 : 0;
+    if (!on) return;
+    unsigned c = ++n[what[0] == 's'];
+    if (c <= 20 || c % 200 == 0)
+        fprintf(stderr, "[audio-ts] %s #%u port=%u in=%llu out=%llu ridx=%llu now=%llu\n", what, c, portNum,
+                (unsigned long long)in, (unsigned long long)out,
+                (unsigned long long)s_ports[portNum].read_index, (unsigned long long)ps3_system_time_us());
+}
