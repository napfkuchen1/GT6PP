+/* Hyp. 23 probe (PS3_LWCLOG): per-cond first 3 wait/signal events, bounded */
+static void lwc_log(const char* what, uint32_t addr, uint32_t id, long waiters, ppu_context* ctx)
+{
+    static int on = -1; if (on < 0) on = getenv("PS3_LWCLOG") ? 1 : 0;
+    if (!on) return;
+    static const auto t0 = GetTickCount64();
+    if (GetTickCount64() - t0 < 90000) return;
+    static struct { uint32_t addr; int w, s; } t[256]; static int nt = 0; static int lines = 0;
+    int k = -1; for (int i = 0; i < nt; i++) if (t[i].addr == addr) { k = i; break; }
+    if (k < 0) { if (nt >= 256) return; k = nt++; t[k].addr = addr; t[k].w = t[k].s = 0; }
+    int* cnt = (what[0] == 'w') ? &t[k].w : &t[k].s;
+    if (++*cnt > 3 || lines > 600) return;
+    lines++;
+    fprintf(stderr, "[LWCLOG] %s cond=0x%08X id=0x%08X waiters=%ld tid=%u lr=0x%08X n=%d\n", what, addr, id, waiters, (unsigned)ctx->thread_id, (unsigned)ctx->lr, *cnt);
+}
