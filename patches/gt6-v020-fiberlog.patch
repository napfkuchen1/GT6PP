+static int fl_n(void){ static int c=0; static int en=-1; if(en<0){const char*e=getenv("PS3_FIBERLOG"); en=e?1:0;} return en && c++<300; }
+#define FL(...) do{ if(fl_n()) { fprintf(stderr,"[FIBER] " __VA_ARGS__); fputc(10,stderr);} }while(0)
 
