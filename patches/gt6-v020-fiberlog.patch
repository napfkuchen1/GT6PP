     if (g_ppu_thread_entry_trampoline)
         g_ppu_thread_entry_trampoline(&f->ctx);   /* runs the entry to completion; its r3 is the status */
 
+    FL("body END fiber=%08X status=%d", f->ea, (int)f->ctx.gpr[3]);
     LOCK();
     fiber_finish_locked(f, (s32)f->ctx.gpr[3]);
     UNLOCK();
@@ -451,6 +455,7 @@ s32 cellFiberPpuCreateFiber(CellFiberPpuScheduler* scheduler, CellFiberPpu* fibe
         free(f);
         return rc;
     }
+    FL("create fiber=%08X opd=%08X arg=%llX stack=%08X sz=%X sched=%08X", fiber_ea, entry, (unsigned long long)arg, stack_ea, sizeStack, sched_ea);
     WAKE();
     return CELL_OK;
 }
@@ -464,6 +469,7 @@ s32 cellFiberPpuRunFibers(CellFiberPpuScheduler* scheduler)
