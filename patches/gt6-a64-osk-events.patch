+/* Queue a dialog status for every sysutil callback slot; delivered from the
+ * guest's next cellSysutilCheckCallback. */
+static void osk_stub_event(u32 status)
+{
+    printf("[cellOskDialog] sysutil status=0x%X\n", status);
+    for (int slot = 0; slot < CELL_SYSUTIL_MAX_CALLBACKS; slot++)
+        cellSysutilQueueEvent(slot, status, 0);
+}
