+/* PS3_WD_FILE=<path>: on-demand diagnostics for a driven session (scripts/play.py dump).
+ * Polled twice a second. A line "wd [<hexaddr>:<hexlen>,...]" takes one watchdog
+ * sample, "snap <dir>" writes a snapshot; the file is emptied when done. */
+static DWORD WINAPI ps3_wdfile_thread(LPVOID p)
+{
+    const char* path = (const char*)p;
+    extern void ppu_report_guest_lrs_ex(const char*);
+    for (int n = 0;;) {
+        Sleep(500);
+        char line[600]; line[0] = 0;
+        FILE* f = fopen(path, "rb");
+        if (!f) continue;
+        if (!fgets(line, sizeof line, f)) line[0] = 0;
+        fclose(f);
+        line[strcspn(line, "\r\n")] = 0;
+        if (!line[0]) continue;
+        fprintf(stderr, "[WDFILE] begin %d %s\n", n, line);
+        if (!strncmp(line, "snap ", 5)) {
+            _putenv_s("PS3_SNAP_DIR", line + 5);
+            ps3_snap_thread((LPVOID)"0");
+        } else {
+            fprintf(stderr, "[WATCHDOG] sample on demand %d\n", n);
+            ppu_report_guest_lrs_ex(n & 1 ? "b" : "a");
+            if (!strncmp(line, "wd ", 3)) ps3_wd_words(line + 3);
+        }
+        fprintf(stderr, "[WDFILE] done %d\n", n++); fflush(stderr);
+        if ((f = fopen(path, "wb"))) fclose(f);
+    }
+}
