+/* <hexaddr>:<hexlen>[,...]: print guest words */
+static void ps3_wd_words(const char* d)
+{
+    while (d && *d) {
+        char* e = 0; uint32_t a = (uint32_t)strtoul(d, &e, 16);
+        uint32_t len = (*e == ':') ? (uint32_t)strtoul(e + 1, &e, 16) : 0x40;
+        for (uint32_t o = 0; o < len; o += 16)
+            fprintf(stderr, "[WDDUMP] %08X: %08X %08X %08X %08X\n", a + o, vm_read32(a + o),
+                    vm_read32(a + o + 4), vm_read32(a + o + 8), vm_read32(a + o + 12));
+        d = (*e == ',') ? e + 1 : 0;
+    }
+}
