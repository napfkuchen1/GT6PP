+/* ATRAC3plus with the channel count in the codec type (SDK ATRACX_2CH/6CH/8CH):
+ * 2048 samples per frame at 48 kHz = 3840 ticks of the 90 kHz clock. */
+#define ADEC_IS_ATRACX_NCH(t) ((t) >= 13u && (t) <= 15u)
+#define ADEC_ATRACX_NCH(t)    ((t) == 13u ? 2u : (t) == 14u ? 6u : 8u)
+#define ADEC_ATRACX_SAMPLES   2048u
+#define ADEC_ATRACX_TICKS     (ADEC_ATRACX_SAMPLES * 90000ull / 48000ull)
 
