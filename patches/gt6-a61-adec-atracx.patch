+                    vm_read32(au + 0x10), vm_read32(au + 0x14) };
+
+    /* Only the first AU of a PES packet carries a time stamp; the demuxer
+     * passes the others on as -1. Gran Turismo 6 throws away every PCM block
+     * stamped -1 (GetPcm(NULL), 0x00FD6DCC), so its movie audio ring never
+     * filled and the movie never started. Continue the stream's clock. */
+    if (ADEC_IS_ATRACX_NCH(a->codecType)) {
+        u64 pts = ((u64)au_w[0] << 32) | au_w[1];
+        if (pts == ~0ull && a->havePts) {
+            pts = a->nextPts;
+            au_w[0] = (u32)(pts >> 32);
+            au_w[1] = (u32)pts;
+        }
+        if (pts != ~0ull) {
+            a->nextPts = pts + ADEC_ATRACX_TICKS;
+            a->havePts = 1;
+        }
+    }
 
