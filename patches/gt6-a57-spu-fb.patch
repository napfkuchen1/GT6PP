  * fallback -- a software-rendered title writes its display buffer straight
  * into guest VRAM and never records RSX work, so the D3D12 backend presents
  * the guest bytes directly. Returns 1 when a buffer is registered. */
+int cellGcm_current_scanout(u32* offset, u32* pitch, u32* width, u32* height);
+
+/* SPU PUTs into a display buffer exist only in guest memory; the backend
+ * uploads the dirty rectangle before it draws on top. x1 == 0: clean. */
+static volatile u32 s_spu_x0[8], s_spu_y0[8], s_spu_x1[8], s_spu_y1[8];
+
+void cellGcm_spu_local_put(u32 off, u32 size)
+{
+    for (u32 i = 0; i < 8 && size; i++) {
+        const u32 p = s_display_buffers[i].pitch, h = s_display_buffers[i].height;
+        if (!s_display_buffer_set[i] || !p) continue;
+        const u32 rel = off - s_display_buffers[i].offset;
+        if (rel >= p * h) continue;
+        const u32 x = (rel % p) / 4u, y = rel / p;
+        const u32 xe = x + size / 4u, ye = (rel + size - 1u) / p + 1u;
+        if (!s_spu_x1[i]) { s_spu_x0[i] = x; s_spu_y0[i] = y; s_spu_y1[i] = ye; s_spu_x1[i] = xe; return; }
+        if (x < s_spu_x0[i]) s_spu_x0[i] = x;
+        if (y < s_spu_y0[i]) s_spu_y0[i] = y;
+        if (xe > s_spu_x1[i]) s_spu_x1[i] = xe;
+        if (ye > s_spu_y1[i]) s_spu_y1[i] = ye;
+        return;
+    }
+}
+
+/* Returns and clears the SPU-written rectangle {x, y, w, h} of the display
+ * buffer registered at `offset`. */
+int cellGcm_take_spu_rect(u32 offset, u32* pitch, u32 r[4])
+{
+    for (u32 i = 0; i < 8; i++) {
+        if (!s_display_buffer_set[i] || s_display_buffers[i].offset != offset || !s_spu_x1[i]) continue;
+        const u32 w = s_display_buffers[i].width, h = s_display_buffers[i].height;
+        const u32 x1 = s_spu_x1[i] < w ? s_spu_x1[i] : w, y1 = s_spu_y1[i] < h ? s_spu_y1[i] : h;
+        r[0] = s_spu_x0[i]; r[1] = s_spu_y0[i];
+        s_spu_x1[i] = 0;
+        if (r[0] >= x1 || r[1] >= y1) return 0;
+        r[2] = x1 - r[0]; r[3] = y1 - r[1];
+        *pitch = s_display_buffers[i].pitch;
+        return 1;
+    }
+    return 0;
+}
