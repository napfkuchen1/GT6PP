+/*
+ * ps3recomp - cellVdec's decoder back end on Windows Media Foundation
+ *
+ * Implements vdec_ffmpeg.h with the H.264 decoder Windows ships, for builds
+ * without PS3RECOMP_FFMPEG_RUNTIME: no headers or libraries to supply.
+ * cellVdec.c serialises all calls.
+ * ponytail: H.264 only; MPEG-2 returns NULL and keeps the callback-only path.
+ */
+
+#include "vdec_ffmpeg.h"
+
+#if defined(_WIN32) && !defined(PS3RECOMP_FFMPEG_RUNTIME)
+
+#define COBJMACROS
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <objbase.h>
+#include <mfapi.h>
+#include <mferror.h>
+#include <mfidl.h>
+#include <mftransform.h>
+#include <wmcodecdsp.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "cellVdec.h"
+
+#pragma comment(lib, "mfplat.lib")
+#pragma comment(lib, "mfuuid.lib")
+#pragma comment(lib, "wmcodecdspuuid.lib")
+#pragma comment(lib, "ole32.lib")
+
+/* The token travels through the decoder as the sample time (100 ns units),
+ * spaced like frames so the times stay plausible. */
+#define TOKEN_TIME 333667LL
+
+struct VdecFf {
+    IMFTransform* mft;
+    u32 codedH;            /* luma rows in the output buffer */
+    u32 width, height;     /* visible picture */
+    u32 stride;
+    u32 frameTicks;
+};
+
+/* Pick NV12 and read back the geometry; also after a stream change. */
+static int mf_set_output(VdecFf* d)
+{
+    for (DWORD i = 0; ; i++) {
+        IMFMediaType* t = NULL;
+        if (FAILED(IMFTransform_GetOutputAvailableType(d->mft, 0, i, &t)))
+            return -1;
+        GUID sub;
+        if (SUCCEEDED(IMFMediaType_GetGUID(t, &MF_MT_SUBTYPE, &sub)) &&
+            IsEqualGUID(&sub, &MFVideoFormat_NV12) &&
+            SUCCEEDED(IMFTransform_SetOutputType(d->mft, 0, t, 0))) {
+            UINT64 size = 0, rate = 0;
+            UINT32 stride = 0;
+            MFVideoArea area;
+            IMFMediaType_GetUINT64(t, &MF_MT_FRAME_SIZE, &size);
+            d->width = (u32)(size >> 32);
+            d->height = d->codedH = (u32)size;
+            if (FAILED(IMFMediaType_GetUINT32(t, &MF_MT_DEFAULT_STRIDE, &stride)))
+                stride = d->width;
+            d->stride = stride;
+            if (SUCCEEDED(IMFMediaType_GetBlob(t, &MF_MT_MINIMUM_DISPLAY_APERTURE,
+                                               (UINT8*)&area, sizeof(area), NULL))) {
+                d->width = (u32)area.Area.cx;
+                d->height = (u32)area.Area.cy;
+            }
+            if (SUCCEEDED(IMFMediaType_GetUINT64(t, &MF_MT_FRAME_RATE, &rate)) &&
+                (rate >> 32))
+                d->frameTicks = (u32)(90000ull * (u32)rate / (rate >> 32));
+            IMFMediaType_Release(t);
+            printf("[cellVdec] MF output %ux%u (coded rows %u, stride %u)\n",
+                   d->width, d->height, d->codedH, d->stride);
+            return 0;
+        }
+        IMFMediaType_Release(t);
+    }
+}
+
+VdecFf* vdec_ff_open(u32 codec_type)
+{
+    static int s_started = 0;
+    if (codec_type != CELL_VDEC_CODEC_TYPE_AVC)
+        return NULL;
+    CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    if (!s_started) {
+        if (FAILED(MFStartup(MF_VERSION, MFSTARTUP_LITE)))
+            return NULL;
+        s_started = 1;
+    }
+    VdecFf* d = (VdecFf*)calloc(1, sizeof(*d));
+    if (!d)
+        return NULL;
+    IMFMediaType* in = NULL;
+    HRESULT hr = CoCreateInstance(&CLSID_CMSH264DecoderMFT, NULL, CLSCTX_INPROC_SERVER,
+                                  &IID_IMFTransform, (void**)&d->mft);
+    if (SUCCEEDED(hr)) hr = MFCreateMediaType(&in);
+    if (SUCCEEDED(hr)) hr = IMFMediaType_SetGUID(in, &MF_MT_MAJOR_TYPE, &MFMediaType_Video);
+    if (SUCCEEDED(hr)) hr = IMFMediaType_SetGUID(in, &MF_MT_SUBTYPE, &MFVideoFormat_H264);
+    if (SUCCEEDED(hr)) hr = IMFTransform_SetInputType(d->mft, 0, in, 0);
+    if (in) IMFMediaType_Release(in);
+    if (FAILED(hr) || mf_set_output(d)) {
+        printf("[cellVdec] Media Foundation H.264 decoder unavailable (0x%08lX)\n",
+               (unsigned long)hr);
+        vdec_ff_close(d);
+        return NULL;
+    }
+    IMFTransform_ProcessMessage(d->mft, MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0);
+    printf("[cellVdec] decoding H.264 through Media Foundation\n");
+    return d;
+}
+
+void vdec_ff_close(VdecFf* d)
+{
+    if (!d) return;
+    if (d->mft) IMFTransform_Release(d->mft);
+    free(d);
+}
+
+/* NV12 output buffer -> unpadded I420, cropped to the visible picture. */
+static void mf_emit(VdecFf* d, IMFSample* s, vdec_ff_emit_fn emit, void* ctx)
+{
+    IMFMediaBuffer* buf = NULL;
+    BYTE* p = NULL;
+    DWORD len = 0;
+    if (FAILED(IMFSample_ConvertToContiguousBuffer(s, &buf)))
+        return;
+    if (SUCCEEDED(IMFMediaBuffer_Lock(buf, &p, NULL, &len))) {
+        const u32 w = d->width, h = d->height;
+        const u32 cw = (w + 1) / 2, ch = (h + 1) / 2;
+        u8* yuv = NULL;
+        if (w && h && (u64)d->stride * (d->codedH + ch) <= len)
+            yuv = (u8*)malloc((size_t)w * h + 2u * (size_t)cw * ch);
+        if (yuv) {
+            u8* u = yuv + (size_t)w * h;
+            u8* v = u + (size_t)cw * ch;
+            const BYTE* uv = p + (size_t)d->stride * d->codedH;
+            for (u32 y = 0; y < h; y++)
+                memcpy(yuv + (size_t)y * w, p + (size_t)y * d->stride, w);
+            for (u32 y = 0; y < ch; y++)
+                for (u32 x = 0; x < cw; x++) {
+                    u[(size_t)y * cw + x] = uv[(size_t)y * d->stride + 2 * x];
+                    v[(size_t)y * cw + x] = uv[(size_t)y * d->stride + 2 * x + 1];
+                }
+            VdecFfPicture pic;
+            LONGLONG t = 0;
+            UINT32 key = 0;
+            IMFSample_GetSampleTime(s, &t);
+            IMFSample_GetUINT32(s, &MFSampleExtension_CleanPoint, &key);
+            memset(&pic, 0, sizeof(pic));
+            pic.yuv = yuv;
+            pic.width = w;
+            pic.height = h;
+            pic.token = (u32)((t + TOKEN_TIME / 2) / TOKEN_TIME);
+            pic.key = key != 0;
+            pic.pict_type = key ? 1 : 0;
+            pic.frame_ticks = d->frameTicks;
+            emit(ctx, &pic);
+        }
+        IMFMediaBuffer_Unlock(buf);
+    }
+    IMFMediaBuffer_Release(buf);
+}
+
+/* Take every picture the decoder has ready. */
+static void mf_pull(VdecFf* d, vdec_ff_emit_fn emit, void* ctx)
+{
+    for (;;) {
+        MFT_OUTPUT_STREAM_INFO si;
+        MFT_OUTPUT_DATA_BUFFER out;
+        IMFMediaBuffer* buf = NULL;
+        DWORD status = 0;
+        memset(&si, 0, sizeof(si));
+        memset(&out, 0, sizeof(out));
+        if (FAILED(IMFTransform_GetOutputStreamInfo(d->mft, 0, &si)))
+            return;
+        if (!(si.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES)) {
+            if (FAILED(MFCreateSample(&out.pSample)))
+                return;
+            if (FAILED(MFCreateAlignedMemoryBuffer(si.cbSize, MF_16_BYTE_ALIGNMENT, &buf))) {
+                IMFSample_Release(out.pSample);
+                return;
+            }
+            IMFSample_AddBuffer(out.pSample, buf);
+            IMFMediaBuffer_Release(buf);
+        }
+        const HRESULT hr = IMFTransform_ProcessOutput(d->mft, 0, 1, &out, &status);
+        if (SUCCEEDED(hr) && out.pSample)
+            mf_emit(d, out.pSample, emit, ctx);
+        if (out.pSample) IMFSample_Release(out.pSample);
+        if (out.pEvents) IMFCollection_Release(out.pEvents);
+        if (hr == MF_E_TRANSFORM_STREAM_CHANGE) {
+            if (mf_set_output(d))
+                return;
+        } else if (FAILED(hr)) {
+            return;                       /* normally NEED_MORE_INPUT */
+        }
+    }
+}
+
+int vdec_ff_decode(VdecFf* d, const u8* au, u32 size, u32 token,
+                   vdec_ff_emit_fn emit, void* ctx)
+{
+    IMFSample* s = NULL;
+    IMFMediaBuffer* buf = NULL;
+    BYTE* p = NULL;
+    if (!d || !size)
+        return -1;
+    CoInitializeEx(NULL, COINIT_MULTITHREADED);   /* per calling thread */
+    HRESULT hr = MFCreateMemoryBuffer(size, &buf);
+    if (SUCCEEDED(hr)) hr = IMFMediaBuffer_Lock(buf, &p, NULL, NULL);
+    if (SUCCEEDED(hr)) {
+        memcpy(p, au, size);
+        IMFMediaBuffer_Unlock(buf);
+        IMFMediaBuffer_SetCurrentLength(buf, size);
+        hr = MFCreateSample(&s);
+    }
+    if (SUCCEEDED(hr)) hr = IMFSample_AddBuffer(s, buf);
+    if (SUCCEEDED(hr)) {
+        IMFSample_SetSampleTime(s, (LONGLONG)token * TOKEN_TIME);
+        hr = IMFTransform_ProcessInput(d->mft, 0, s, 0);
+        if (hr == MF_E_NOTACCEPTING) {
+            mf_pull(d, emit, ctx);
+            hr = IMFTransform_ProcessInput(d->mft, 0, s, 0);
+        }
+    }
+    if (s) IMFSample_Release(s);
+    if (buf) IMFMediaBuffer_Release(buf);
+    mf_pull(d, emit, ctx);
+    return SUCCEEDED(hr) ? 0 : -1;
+}
+
+void vdec_ff_drain(VdecFf* d, vdec_ff_emit_fn emit, void* ctx)
+{
+    if (!d) return;
+    CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    IMFTransform_ProcessMessage(d->mft, MFT_MESSAGE_COMMAND_DRAIN, 0);
+    mf_pull(d, emit, ctx);
+    vdec_ff_reset(d);
+}
+
+void vdec_ff_reset(VdecFf* d)
+{
+    if (d) IMFTransform_ProcessMessage(d->mft, MFT_MESSAGE_COMMAND_FLUSH, 0);
+}
+
+#endif /* _WIN32 && !PS3RECOMP_FFMPEG_RUNTIME */
