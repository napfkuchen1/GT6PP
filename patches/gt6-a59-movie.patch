+/* ---------------------------------------------------------------------------
+ * Header queries without a reader, and per-stream ids
+ * ponytail: the EP iterator calls (ReaderGetEpIteratorWithTimeStamp,
+ * EpIteratorGetEp/Move) are still unregistered; add them when a title seeks.
+ * -----------------------------------------------------------------------*/
+static const u8* pamf_header(void* guest_ea)
+{
+    if (!guest_ea)
+        return NULL;
+    const u8* base = GUEST_PTR(guest_ea, const u8*);
+    return be32(base) == CELL_PAMF_MAGIC && be32(base + 0x08) ? base : NULL;
+}
+
+s32 cellPamfVerify(void* pamfAddr, u64 fileSize)
+{
+    if (!pamfAddr)
+        return (s32)CELL_PAMF_ERROR_INVALID_ARG;
+    const u8* base = pamf_header(pamfAddr);
+    if (!base || !base[PAMF_OFF_NUM])
+        return (s32)CELL_PAMF_ERROR_INVALID_HEADER;
+    const u64 total = ((u64)be32(base + 0x08) + be32(base + 0x0C)) * PAMF_SECTOR;
+    if (fileSize && fileSize < total)
+        return (s32)CELL_PAMF_ERROR_INVALID_HEADER;
+    return CELL_OK;
+}
+
+s32 cellPamfGetHeaderSize2(void* pamfAddr, u64 fileSize, u32 attribute, u64* headerSize)
+{
+    (void)fileSize;
+    const u8* base = pamf_header(pamfAddr);
+    if (!headerSize)
+        return (s32)CELL_PAMF_ERROR_INVALID_ARG;
+    if (!base)
+        return (s32)CELL_PAMF_ERROR_INVALID_HEADER;
+    /* attribute 2: minimum header, without the entry point tables */
+    const u64 size = (attribute & 2) ? 0x54u + (u64)be32(base + 0x50)
+                                     : (u64)be32(base + 0x08) * PAMF_SECTOR;
+    vm_write64((u32)(uintptr_t)headerSize, size);
+    return CELL_OK;
+}
+
+s32 cellPamfGetStreamOffsetAndSize(void* pamfAddr, u64 fileSize, u64* offset, u64* size)
+{
+    (void)fileSize;
+    const u8* base = pamf_header(pamfAddr);
+    if (!offset || !size)
+        return (s32)CELL_PAMF_ERROR_INVALID_ARG;
+    if (!base)
+        return (s32)CELL_PAMF_ERROR_INVALID_HEADER;
+    vm_write64((u32)(uintptr_t)offset, (u64)be32(base + 0x08) * PAMF_SECTOR);
+    vm_write64((u32)(uintptr_t)size, (u64)be32(base + 0x0C) * PAMF_SECTOR);
+    return CELL_OK;
+}
+
+static int is_video_type(s32 type)
+{
+    return type == CELL_PAMF_STREAM_TYPE_AVC || type == CELL_PAMF_STREAM_TYPE_M2V;
+}
+
+s32 cellPamfReaderGetStreamTypeAndChannel(CellPamfReader* reader, u8* type, u8* channel)
+{
+    reader = pamf_get(reader);
+    if (!reader || !type || !channel)
+        return (s32)CELL_PAMF_ERROR_INVALID_ARG;
+    const u8* d = get_stream_desc_raw(reader, reader->currentStream);
+    if (!d || raw_type_to_sdk(d[0]) < 0)
+        return (s32)CELL_PAMF_ERROR_STREAM_NOT_FOUND;
+    const s32 t = raw_type_to_sdk(d[0]);
+    vm_write8((u32)(uintptr_t)type, (u8)t);
+    vm_write8((u32)(uintptr_t)channel, (u8)((is_video_type(t) ? d[4] : d[5]) & 0x0F));
+    return CELL_OK;
+}
+
+s32 cellPamfReaderGetEsFilterId(CellPamfReader* reader, void* esFilterId)
+{
+    reader = pamf_get(reader);
+    if (!reader || !esFilterId)
+        return (s32)CELL_PAMF_ERROR_INVALID_ARG;
+    const u8* d = get_stream_desc_raw(reader, reader->currentStream);
+    if (!d)
+        return (s32)CELL_PAMF_ERROR_STREAM_NOT_FOUND;
+    const u32 ea = (u32)(uintptr_t)esFilterId;
+    vm_write32(ea + 0x0, d[4]);           /* stream id */
+    vm_write32(ea + 0x4, d[5]);           /* private stream id */
+    vm_write32(ea + 0x8, d[0] == CELL_PAMF_CODEC_TYPE_AVC);
+    vm_write32(ea + 0xC, 0);
+    return CELL_OK;
+}
+
+/* Returns the overall index of the index-th stream of that type. */
+s32 cellPamfReaderSetStreamWithTypeAndIndex(CellPamfReader* reader, u8 streamType, u8 index)
+{
+    const s32 rc = cellPamfReaderSetStreamWithType(reader, streamType, index);
+    return rc == CELL_OK ? pamf_get(reader)->currentStream : rc;
+}
