+static int d3d12_rt_readback(u32 offset, u32 pitch, u32 w, u32 h, u8* dst)
+{
+    static ID3D12Resource* rb = NULL;
+    static u64 rb_size = 0;
+    u32 x = 0, y = 0;
+    if (!s_d3d.initialized || pitch <= 64 || !w || !h || !dst) return 0;
+    if (off_rt_containing(offset, pitch, &x, &y) < 0) return 0;
+    if (s_d3d.draw_count) {
+        s_flush_only = 1;
+        s_present_this_frame = 0;
+        render_frame();
+        s_present_this_frame = 1;
+        s_flush_only = 0;
+    }
+    const int p = off_rt_containing(offset, pitch, &x, &y);
+    if (p < 0) return 0;
+    OffRT* r = &s_d3d.off_rt[p];
+    if (x + w > r->w) w = r->w - x;
+    if (y + h > r->h) h = r->h - y;
+    const u32 rpitch = (w * 4u + 255u) & ~255u;
+    const u64 need = (u64)rpitch * h;
+    wait_for_gpu();
+    if (rb_size < need) {
+        if (rb) { rb->lpVtbl->Release(rb); rb = NULL; rb_size = 0; }
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC rd = {0};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        rd.Width = need; rd.Height = 1; rd.DepthOrArraySize = 1;
+        rd.MipLevels = 1; rd.SampleDesc.Count = 1;
+        rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+                s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+                &IID_ID3D12Resource, (void**)&rb)))
+            return 0;
+        rb_size = need;
+    }
+    const u32 fi = s_d3d.frame_index;
+    s_d3d.cmd_allocators[fi]->lpVtbl->Reset(s_d3d.cmd_allocators[fi]);
+    s_d3d.cmd_list->lpVtbl->Reset(s_d3d.cmd_list, s_d3d.cmd_allocators[fi], NULL);
+    dred_list_reset();
+    const D3D12_RESOURCE_STATES prior = r->st;
+    off_rt_transition(p, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    D3D12_TEXTURE_COPY_LOCATION to = {0}, from = {0};
+    to.pResource = rb; to.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    to.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    to.PlacedFootprint.Footprint.Width = w;
+    to.PlacedFootprint.Footprint.Height = h;
+    to.PlacedFootprint.Footprint.Depth = 1;
+    to.PlacedFootprint.Footprint.RowPitch = rpitch;
+    from.pResource = r->res; from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    D3D12_BOX box = { x, y, 0, x + w, y + h, 1 };
+    dred_copy(__LINE__, &to, &from);
+    s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &to, 0, 0, 0, &from, &box);
+    off_rt_transition(p, prior);
+    s_d3d.cmd_list->lpVtbl->Close(s_d3d.cmd_list);
+    ID3D12CommandList* cl[] = { (ID3D12CommandList*)s_d3d.cmd_list };
+    s_d3d.cmd_queue->lpVtbl->ExecuteCommandLists(s_d3d.cmd_queue, 1, cl);
+    wait_for_gpu();
+    void* mp = NULL; D3D12_RANGE rr = {0, (SIZE_T)need};
+    if (FAILED(rb->lpVtbl->Map(rb, 0, &rr, &mp)) || !mp) return 0;
+    for (u32 row = 0; row < h; row++) {
+        const u8* s = (const u8*)mp + (u64)row * rpitch;
+        u8* d = dst + (u64)row * pitch;
+        for (u32 c = 0; c < w; c++) {
+            u32 v;
+            memcpy(&v, s + c * 4u, 4);
+            v = (v << 8) | (v >> 24);       /* R,G,B,A -> A,R,G,B */
+            memcpy(d + c * 4u, &v, 4);
+        }
+    }
+    D3D12_RANGE wr = {0, 0};
+    rb->lpVtbl->Unmap(rb, 0, &wr);
+    return 1;
+}
