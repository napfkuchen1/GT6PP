+/* A guest-side transfer reads a colour surface that exists only on the GPU
+ * (GT6 copies its showroom 3D surface to main memory with NV3089): run the
+ * pending batch, then store the w x h block at `offset` into `dst` as the
+ * guest's A,R,G,B bytes. Called from the FIFO drain, i.e. the thread that
+ * also renders. */
+static int off_rt_containing(u32 offset, u32 pitch, u32* px, u32* py)
+{
+    int p = -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (!r->res || r->pitch != pitch || r->off > offset ||
+            r->dxgi != (u32)DXGI_FORMAT_R8G8B8A8_UNORM) continue;
+        const u32 d = offset - r->off, y = d / pitch, x = (d % pitch) / 4u;
+        if (x >= r->w || y >= r->h) continue;
+        if (p >= 0 && r->off < s_d3d.off_rt[p].off) continue;
+        p = i; *px = x; *py = y;
+    }
+    return p;
+}
