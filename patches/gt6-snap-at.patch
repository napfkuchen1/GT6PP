+/* PS3_SNAP_AT=<s>: offline snapshot (see runtime/diag/ps3_snapshot.c). Dir = PS3_SNAP_DIR or snap_<ts>. */
+extern "C" void ps3_snap_dump_sync(const char*);
+extern "C" void ps3_snap_dump_mem(const char*);
+extern "C" void ps3_snap_dump_stack(const char*, unsigned, uint32_t);
+#ifdef _WIN32
+static DWORD WINAPI ps3_snap_thread(LPVOID p)
+{
+    Sleep((DWORD)(atof((const char*)p) * 1000.0));
+    char dir[400]; const char* e = getenv("PS3_SNAP_DIR");
+    if (e && *e) snprintf(dir, sizeof dir, "%s", e);
+    else snprintf(dir, sizeof dir, "snap_%lu", (unsigned long)GetTickCount());
+    CreateDirectoryA(dir, NULL);
+    fprintf(stderr, "[SNAP] start dir=%s\n", dir); fflush(stderr);
+    char path[460]; snprintf(path, sizeof path, "%s/threads.txt", dir);
+    FILE* f = fopen(path, "w");
+    long n = g_resv_ctx_n; if (n > PPU_RESV_MAX) n = PPU_RESV_MAX;
+    for (long i = 0; i < n; i++) {
+        ppu_context* c = g_resv_ctxs[i]; if (!c) continue;
+        unsigned t = (unsigned)c->thread_id;
+        if (f) {
+            fprintf(f, "thread %u lr=%08X ctr=%08X cia=%08X cr=%08X sp=%08X inflight_sc=%u hle=%s\n", t,
+                    (uint32_t)c->lr, (uint32_t)c->ctr, (uint32_t)c->cia, c->cr, (uint32_t)c->gpr[1],
+                    t < 64u ? g_sc_inflight[t] : 0u, (t < 64u && g_hle_inflight[t]) ? g_hle_inflight[t] : "-");
+            for (int r = 0; r < 32; r++) fprintf(f, " r%d=%08X%08X", r, (uint32_t)(c->gpr[r] >> 32), (uint32_t)c->gpr[r]);
+            fprintf(f, "\n");
+        }
+        uint32_t sp = (uint32_t)c->gpr[1];
+        if (sp >= 0x10000u && sp < 0xFFFF0000u) ps3_snap_dump_stack(dir, t, sp);
+    }
+    if (f) fclose(f);
+    ps3_snap_dump_sync(dir);
+    ps3_snap_dump_mem(dir);
+    snprintf(path, sizeof path, "%s/meta.txt", dir);
+    if ((f = fopen(path, "w"))) { fprintf(f, "ram_main.bin=0x%08X ram_hle.bin=0x%08X big-endian guest bytes\n", (unsigned)VM_MAIN_MEM_BASE, (unsigned)VM_HLE_HEAP_BASE); fclose(f); }
+    fprintf(stderr, "[SNAP] done dir=%s\n", dir); fflush(stderr);
+    return 0;
+}
