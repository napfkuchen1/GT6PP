@@ -1708,6 +1708,25 @@ static void rsx_capture_frame(u32 fi, u32 ndraws, u32 capidx)
                                 (r->tex[u].fmt & 0x20) ? "LN" : "SZ",
                                 (r->tex[u].fmt & 0x40) ? ",NR" : "",
                                 r->tex[u].w, r->tex[u].h, r->tex[u].ctrl1 & 0xFFFF);
+                /* RSX_CAP_VHASH=1: hash of the decoded vertices (attr0) per draw,
+                 * so two frames of a static scene can be compared. */
+                if (!r->is_clear && s_d3d.vp_vb_mapped && getenv("RSX_CAP_VHASH")) {
+                    const u32 par = (u32)(s_d3d.vp_parity ^ 1);
