+    /* PAD_LOG=<path>: record (seconds since first poll, final button mask) on
+     * every change of port 0 -- same encoding as PAD_SCRIPT, so a live
+     * session can be replayed with PAD_SCRIPT="<sec>:0x<mask> ...". */
+    { static int s_pl = -1; static FILE* s_plf; static clock_t s_pl_t0; static unsigned s_pl_last = 0;
+      if (s_pl < 0) { const char* e = getenv("PAD_LOG");
+                      s_pl = (e && *e) ? 1 : 0;
+                      if (s_pl) { s_plf = fopen(e, "w"); s_pl_t0 = clock(); if (!s_plf) s_pl = 0; } }
+      if (s_pl && port_no == 0) {
+          unsigned m = (unsigned)(data->button[CELL_PAD_BTN_OFFSET_DIGITAL1] & 0xFF)
+                     | ((unsigned)(data->button[CELL_PAD_BTN_OFFSET_DIGITAL2] & 0xFF) << 8);
+          if (m != s_pl_last) {
+              fprintf(s_plf, "%.2f:0x%04X\n", (double)(clock() - s_pl_t0) / CLOCKS_PER_SEC, m);
+              fflush(s_plf); s_pl_last = m; } } }
