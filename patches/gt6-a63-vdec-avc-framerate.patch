  * Decoder path (libavcodec present)
  * -----------------------------------------------------------------------*/
 
+/* VDEC_TIMING=1: every 30th picture handed out, the wall time and the host time
+ * spent decoding and storing since the previous report. */
+static struct { int on; u64 decUs, storeUs, last; u32 aus, busy, pics; } s_tm = { -1 };
+
+static u64 vdec_now_us(void)
+{
+#ifdef _WIN32
+    LARGE_INTEGER c, f;
+    QueryPerformanceCounter(&c);
+    QueryPerformanceFrequency(&f);
+    return (u64)(c.QuadPart * 1000000 / f.QuadPart);
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (u64)ts.tv_sec * 1000000u + (u64)ts.tv_nsec / 1000u;
+#endif
+}
+
+static int vdec_timing(void)
+{
+    if (s_tm.on < 0) s_tm.on = getenv("VDEC_TIMING") ? 1 : 0;
+    return s_tm.on;
+}
+
 static void vdec_queue_clear(VdecSlot* v)
