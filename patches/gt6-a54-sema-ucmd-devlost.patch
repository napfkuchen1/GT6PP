+/* Say once when and why the device was lost: every later frame is black and
+ * only the fence wait reported it before. With D3D12_DBG=1 the debug layer's
+ * errors are printed as they appear, so the command that killed it is named. */
+static void d3d_check_removed(const char* where)
+{
+    static int gone, dbg = -1, shown;
+    if (gone) return;
+    if (dbg < 0) dbg = getenv("D3D12_DBG") ? 1 : 0;
+    const HRESULT rr = s_d3d.device->lpVtbl->GetDeviceRemovedReason(s_d3d.device);
+    if (dbg) {
+        ID3D12InfoQueue* iq = NULL;
+        if (SUCCEEDED(s_d3d.device->lpVtbl->QueryInterface(
+                s_d3d.device, &IID_ID3D12InfoQueue, (void**)&iq)) && iq) {
+            const UINT64 n = iq->lpVtbl->GetNumStoredMessages(iq);
+            for (UINT64 mi = 0; mi < n && shown < 60; mi++) {
+                SIZE_T len = 0;
+                iq->lpVtbl->GetMessage(iq, mi, NULL, &len);
+                D3D12_MESSAGE* m = (D3D12_MESSAGE*)malloc(len);
+                if (m && SUCCEEDED(iq->lpVtbl->GetMessage(iq, mi, m, &len)) &&
+                    m->Severity <= D3D12_MESSAGE_SEVERITY_ERROR) {
+                    shown++;
+                    printf("[D3D12][DBG] %s id=%d %s\n", where, (int)m->ID, m->pDescription);
+                }
+                free(m);
+            }
+            iq->lpVtbl->ClearStoredMessages(iq);
+            iq->lpVtbl->Release(iq);
+        }
+    }
+    if (rr != S_OK) {
+        gone = 1;
+        printf("[D3D12] DEVICE REMOVED seen at %s: reason 0x%08lX\n", where, (long)rr);
+        fflush(stdout);
+    }
+}
