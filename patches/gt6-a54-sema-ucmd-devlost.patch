+/* Resources the open command list may still reference. wait_for_gpu() covers
+ * submitted work only, so freeing one mid-recording is a GPU page fault (device
+ * hung). They are released at the next frame start instead. */
+#define D3D_RETIRE_MAX 1024
+static ID3D12Resource* s_retired[D3D_RETIRE_MAX];
+static unsigned s_nretired;
+static void d3d_retire(ID3D12Resource* r)
+{
+    if (r && s_nretired < D3D_RETIRE_MAX)   /* full: leak, never free in use */
+        s_retired[s_nretired++] = r;
+}
+static void d3d_drain_retired(void)
+{
+    while (s_nretired) {
+        ID3D12Resource* r = s_retired[--s_nretired];
+        r->lpVtbl->Release(r);
+    }
+}
