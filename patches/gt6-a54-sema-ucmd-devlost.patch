+/* Causes not yet handed to the user handler, in FIFO order. The walker retires
+ * many user interrupts per pass while the pump delivers later, so one slot lost
+ * causes (GT6: cause 1 overwritten by cause 0, guest then waits out 5 s). */
+#define GCM_UCQ_N 256u
+static u32 s_ucq[GCM_UCQ_N];
+static unsigned s_ucq_r, s_ucq_w;
+static atomic_flag s_ucq_lock = ATOMIC_FLAG_INIT;
+static void gcm_ucq_lock(void)   { while (atomic_flag_test_and_set_explicit(&s_ucq_lock, memory_order_acquire)) {} }
+static void gcm_ucq_unlock(void) { atomic_flag_clear_explicit(&s_ucq_lock, memory_order_release); }
+static void gcm_ucq_reset(void)  { gcm_ucq_lock(); s_ucq_r = s_ucq_w = 0; gcm_ucq_unlock(); }
+static void gcm_ucq_push(u32 cmd)
+{
+    gcm_ucq_lock();
+    const int full = s_ucq_w - s_ucq_r >= GCM_UCQ_N;
+    if (!full) s_ucq[s_ucq_w++ % GCM_UCQ_N] = cmd;
+    gcm_ucq_unlock();
+    if (full) { static int n; if (n++ < 8) fprintf(stderr, "[ucmd] queue full, cause %u dropped\n", cmd); }
+}
+static int gcm_ucq_pop(u32* cmd)
+{
+    gcm_ucq_lock();
+    const int have = s_ucq_r != s_ucq_w;
+    if (have) *cmd = s_ucq[s_ucq_r++ % GCM_UCQ_N];
+    gcm_ucq_unlock();
+    return have;
+}
