+/* D3D12_DRED=1: auto breadcrumbs + page-fault data, plus one record per draw of
+ * the last few command lists, so a draw that hangs the GPU can be named. Every
+ * Draw*Instanced call site must call dred_note or the ordinals drift. */
+#define DRED_LISTS 4
+#define DRED_DRAWS 8192
+typedef struct { u32 fp, verts, w, h; int rt; char kind; } DredDraw;
+static struct { u32 n; DredDraw d[DRED_DRAWS]; } s_dred_list[DRED_LISTS];
+/* CopyTextureRegion calls of the same lists: source range against the fault VA. */
+#define DRED_COPIES 4096
+typedef struct { int line; D3D12_TEXTURE_COPY_LOCATION dst, src;
+                 D3D12_RESOURCE_DESC dd, sd; u64 sva; } DredCopy;
+static struct { u32 n; DredCopy c[DRED_COPIES]; } s_dred_copy[DRED_LISTS];
+static unsigned s_dred_cur;
+static int s_dred;
+
+static void dred_list_reset(void)
+{
+    if (!s_dred) return;
+    s_dred_cur = (s_dred_cur + 1) % DRED_LISTS;
+    s_dred_list[s_dred_cur].n = 0;
+    s_dred_copy[s_dred_cur].n = 0;
+}
+static void dred_copy(int line, const D3D12_TEXTURE_COPY_LOCATION* dst,
+                      const D3D12_TEXTURE_COPY_LOCATION* src)
+{
+    if (!s_dred) return;
+    const u32 i = s_dred_copy[s_dred_cur].n++;
+    if (i >= DRED_COPIES) return;
+    DredCopy* c = &s_dred_copy[s_dred_cur].c[i];
+    c->line = line; c->dst = *dst; c->src = *src;
+    dst->pResource->lpVtbl->GetDesc(dst->pResource, &c->dd);
+    src->pResource->lpVtbl->GetDesc(src->pResource, &c->sd);
+    c->sva = c->sd.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER
+             ? src->pResource->lpVtbl->GetGPUVirtualAddress(src->pResource) : 0;
+}
+static void dred_note(char kind, u32 fp, u32 verts, int rt, u32 w, u32 h)
+{
+    if (!s_dred) return;
+    const u32 i = s_dred_list[s_dred_cur].n++;
+    if (i < DRED_DRAWS) {
+        DredDraw* r = &s_dred_list[s_dred_cur].d[i];
+        r->kind = kind; r->fp = fp; r->verts = verts; r->rt = rt; r->w = w; r->h = h;
+    }
+}
+static void dred_enable(void)
+{
+    if (!getenv("D3D12_DRED")) return;
+    ID3D12DeviceRemovedExtendedDataSettings* st = NULL;
+    const HRESULT hr = D3D12GetDebugInterface(
+        &IID_ID3D12DeviceRemovedExtendedDataSettings, (void**)&st);
+    if (FAILED(hr) || !st) {
+        printf("[D3D12][DRED] unavailable (0x%08lX)\n", (long)hr);
+        return;
+    }
+    st->lpVtbl->SetAutoBreadcrumbsEnablement(st, D3D12_DRED_ENABLEMENT_FORCED_ON);
+    st->lpVtbl->SetPageFaultEnablement(st, D3D12_DRED_ENABLEMENT_FORCED_ON);
+    st->lpVtbl->Release(st);
+    s_dred = 1;
+    printf("[D3D12][DRED] breadcrumbs on\n");
+}
+static void dred_report(void)
+{
+    if (!s_dred) return;
+    ID3D12DeviceRemovedExtendedData* dd = NULL;
+    if (FAILED(s_d3d.device->lpVtbl->QueryInterface(
