+/* One offset can hold surfaces of two formats within a frame (GT6 uses one
+ * scratch buffer as RGBA16F and as A8R8G8B8). A slot is therefore identified
+ * by offset and host format: recreating a single slot dropped the earlier
+ * draws and reseeded the surface from guest memory. */
+static DXGI_FORMAT off_rt_dxgi(u32 rsx_fmt)
+{
+    /* RT_FORCE_RGBA8=1: see off_rt_get. */
+    static int f8 = -1;
+    if (f8 < 0) { const char* e = getenv("RT_FORCE_RGBA8"); f8 = e ? atoi(e) : 0; }
+    return f8 ? DXGI_FORMAT_R8G8B8A8_UNORM : rsx_surface_dxgi(rsx_fmt);
+}
+
+static int off_rt_find_fmt(u32 off, DXGI_FORMAT fmt)
+{
+    if (!off) return -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++)
+        if (s_d3d.off_rt[i].res && s_d3d.off_rt[i].off == off &&
+            s_d3d.off_rt[i].dxgi == (u32)fmt) return i;
+    return -1;
+}
+
+/* The surface a texture of this format reads; any surface at the offset when
+ * none has the matching layout. */
+static int off_rt_find_tex(u32 off, u32 tex_fmt)
+{
+    const u32 base = tex_fmt & 0x9F;
+    const int i = off_rt_find_fmt(off,
+        base == 0x9A ? DXGI_FORMAT_R16G16B16A16_FLOAT :
+        base == 0x9B ? DXGI_FORMAT_R32G32B32A32_FLOAT :
+        base == 0x9C ? DXGI_FORMAT_R32_FLOAT : DXGI_FORMAT_R8G8B8A8_UNORM);
+    return i >= 0 ? i : off_rt_find(off);
+}
