+/* GCM_PARKTRACE=1: keep the last FIFO branches, label operations and SPU PUTs
+ * and print them when a self-JUMP park is given up on (or an SPU is halted for
+ * polling) -- who jumped to the park, who patches it, who releases a label. */
+typedef struct { u32 kind, io, a, b; unsigned long long t; } gcm_pt_ev;
+static gcm_pt_ev s_pt_br[256], s_pt_sem[256];
+static unsigned s_pt_nbr, s_pt_nsem;
+static struct { u32 ea, size, cmd, pc, img; unsigned long long t; } s_pt_dma[16384];
+static volatile long s_pt_ndma;
+static int gcm_pt_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("GCM_PARKTRACE") ? 1 : 0;
+    return on;
+}
+static void gcm_pt_br(u32 kind, u32 io, u32 a, u32 b)
+{
+    extern unsigned long long ps3_ms_now(void);
+    if (!gcm_pt_on()) return;
+    gcm_pt_ev* e = &s_pt_br[s_pt_nbr++ & 255];
+    e->kind = kind; e->io = io; e->a = a; e->b = b; e->t = ps3_ms_now();
+}
+/* kind: 'A' acquire, 'L' 406E release, 'B' back-end, 'T' texture release,
+ * 'R' release replayed by a resync. */
+static void gcm_pt_sem(u32 kind, u32 io, u32 off, u32 v)
+{
+    extern unsigned long long ps3_ms_now(void);
+    static u32 last_off = ~0u, last_v;
+    if (!gcm_pt_on()) return;
+    if (kind == 'A') { if (off == last_off && v == last_v) return; last_off = off; last_v = v; }
+    gcm_pt_ev* e = &s_pt_sem[s_pt_nsem++ & 255];
+    e->kind = kind; e->io = io; e->a = off; e->b = v; e->t = ps3_ms_now();
+    if ((off & 0xFFFFu) >= 0x500u && (off & 0xFFFFu) < 0x560u) {
+        static int n;
+        if (PS3_LOG_FIRST(n, 200))
+            fprintf(stderr, "[ptrace-lbl] %c io=%08X off=0x%X v=0x%08X t=%llu\n", (int)kind, io, off, v, e->t);
+    }
+}
+void ps3_ptrace_dma(u32 ea, u32 size, u32 cmd, u32 pc, u32 img)
+{
+    extern unsigned long long ps3_ms_now(void);
+    static volatile long long n;
+    if (!gcm_pt_on() || (cmd & 0xF0u) == 0x40u) return;   /* PUTs and atomics */
+    if (!((ea >= 0x60000000u && ea < 0x70000000u) || (ea >= 0x03000000u && ea < 0x03001000u))) return;
+    const unsigned i = (unsigned)(++n) & 16383u;   /* diagnostic: a lost race costs one entry */
+    s_pt_ndma = (long)n;
+    s_pt_dma[i].ea = ea; s_pt_dma[i].size = size; s_pt_dma[i].cmd = cmd;
+    s_pt_dma[i].pc = pc; s_pt_dma[i].img = img; s_pt_dma[i].t = ps3_ms_now();
+}
+void ps3_ptrace_dump(const char* why, u32 park_io)
+{
+    extern unsigned long long ps3_ms_now(void);
+    static int dumps;
+    if (!gcm_pt_on() || dumps >= 3) return;
+    dumps++;
+    if (!park_io) park_io = park_off;
+    const u32 pea = park_io ? gcm_io2ea(park_io) : 0;
+    fprintf(stderr, "[ptrace] dump %s park io=%08X ea=%08X t=%llu\n", why, park_io, pea, ps3_ms_now());
+    for (u32 a = 0x500u; a < 0x560u; a += 16u)
+        fprintf(stderr, "[ptrace] label %03X: %08X %08X %08X %08X\n", a,
+                vm_read32(GCM_LABEL_GUEST_BASE + a), vm_read32(GCM_LABEL_GUEST_BASE + a + 4),
+                vm_read32(GCM_LABEL_GUEST_BASE + a + 8), vm_read32(GCM_LABEL_GUEST_BASE + a + 12));
+    for (unsigned k = s_pt_nbr > 96 ? s_pt_nbr - 96 : 0; k < s_pt_nbr; k++) {
+        const gcm_pt_ev* e = &s_pt_br[k & 255];
+        fprintf(stderr, "[ptrace] br %c %08X -> %08X put=%08X t=%llu\n", (int)e->kind, e->io, e->a, e->b, e->t);
+    }
+    for (unsigned k = s_pt_nsem > 96 ? s_pt_nsem - 96 : 0; k < s_pt_nsem; k++) {
+        const gcm_pt_ev* e = &s_pt_sem[k & 255];
+        fprintf(stderr, "[ptrace] sem %c io=%08X off=0x%X v=0x%08X t=%llu\n", (int)e->kind, e->io, e->a, e->b, e->t);
+    }
+    {
+        const unsigned n = (unsigned)s_pt_ndma;
+        unsigned shown = 0;
+        for (unsigned k = n > 16383u ? n - 16383u : 1u; k <= n; k++) {
+            const unsigned i = k & 16383u;
+            const int hit = (pea && s_pt_dma[i].ea < pea + 0x20u && s_pt_dma[i].ea + s_pt_dma[i].size > pea - 0x20u)
+                         || (s_pt_dma[i].ea >= 0x03000500u && s_pt_dma[i].ea < 0x03000560u);
+            if (hit && shown++ < 80)
+                fprintf(stderr, "[ptrace] dma img=%u pc=%05X cmd=%02X ea=%08X size=%u t=%llu\n", s_pt_dma[i].img,
+                        s_pt_dma[i].pc, s_pt_dma[i].cmd, s_pt_dma[i].ea, s_pt_dma[i].size, s_pt_dma[i].t);
+        }
+        for (unsigned k = n > 24u ? n - 24u : 1u; k <= n; k++) {
+            const unsigned i = k & 16383u;
+            fprintf(stderr, "[ptrace] lastdma img=%u pc=%05X cmd=%02X ea=%08X size=%u t=%llu\n", s_pt_dma[i].img,
+                    s_pt_dma[i].pc, s_pt_dma[i].cmd, s_pt_dma[i].ea, s_pt_dma[i].size, s_pt_dma[i].t);
+        }
+        fprintf(stderr, "[ptrace] dma total=%u hits=%u\n", n, shown);
+    }
+    fflush(stderr);
+}
